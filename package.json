{
	"name": "obsidian-wechat-publish",
	"version": "1.3.1",
	"description": "One-click copy markdown to WeChat Official Account",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node scripts/build-mathjax-svg.mjs && node esbuild.config.mjs production",
		"lint": "eslint ./src/",
		"test": "vitest run",
		"verify:version": "node scripts/verify-version.mjs",
		"release:notes": "node scripts/generate-release-notes.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"deploy": "node scripts/deploy.js"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"wechat",
		"markdown"
	],
	"author": "TinyKing",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@eslint/json": "0.14.0",
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-replace": "^6.0.3",
		"@rollup/plugin-typescript": "^12.3.0",
		"@types/node": "^22.20.1",
		"esbuild": "^0.28.2",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"globals": "14.0.0",
		"jiti": "^2.7.0",
		"linkedom": "^0.18.13",
		"rollup": "^4.62.4",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.67.0",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"juice": "^11.1.1",
		"lucide-static": "^1.32.0",
		"markdown-it": "^15.0.0",
		"markdown-it-mark": "^4.0.0",
		"mathjax-full": "^3.2.1",
		"obsidian": "latest",
		"yaml": "^2.9.0"
	},
	"overrides": {
		"encoding-sniffer": "1.0.2",
		"@xmldom/xmldom": "0.9.11"
	}
}
