{
	"name": "obsidian-wechat-publish",
	"version": "1.2.0",
	"description": "One-click copy markdown to WeChat Official Account",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node scripts/build-mathjax-svg.mjs && node esbuild.config.mjs production",
		"lint": "eslint ./src/",
		"test": "vitest run",
		"verify:version": "node scripts/verify-version.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"deploy": "node scripts/deploy.js"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"wechat",
		"markdown"
	],
	"author": "TinyKing",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "9.30.1",
		"@eslint/json": "0.14.0",
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-replace": "^6.0.3",
		"@rollup/plugin-typescript": "^12.3.0",
		"@types/markdown-it": "^14.1.2",
		"@types/node": "^16.11.6",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"linkedom": "^0.18.12",
		"rollup": "^4.61.0",
		"rollup-plugin-terser": "^7.0.2",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1",
		"vitest": "^4.1.6"
	},
	"dependencies": {
		"juice": "^11.1.0",
		"lucide-static": "^1.16.0",
		"markdown-it": "^14.1.0",
		"markdown-it-mark": "^4.0.0",
		"mathjax-full": "^3.2.1",
		"obsidian": "latest",
		"yaml": "^2.9.0"
	}
}
